#!/usr/bin/env bash
#
# Pre-push gate. Each check blocks the push, so untracked or red work never
# reaches the remote (and CI).
#
#   0. the branch's PR is not already merged — pushing there orphans the commit
#   1. the branch maps to a documented task in task.md
#   2. the deterministic test suite passes
#
# Installed by the harness installer. Override in a genuine emergency only:
#   git push --no-verify
#
set -euo pipefail

repo="$(git rev-parse --show-toplevel)"

run_guard() {
    local script="$1" label="$2" hint="$3"
    [ -f "$repo/scripts/$script" ] || return 0      # guard not installed — skip
    echo "[pre-push] $label"
    if ! python3 "$repo/scripts/$script"; then
        echo "[pre-push]    $hint"
        exit 1
    fi
}

run_guard check_branch_not_merged.py \
    "checking the branch's PR isn't already merged..." \
    "Branch fresh off develop, or override with: git push --no-verify"

run_guard check_task_tracked.py \
    "checking task tracking..." \
    "Fix by adding the task.md entry, or override with: git push --no-verify"

# Tests: the command is the repo's own, from .harness.json. A repo with no test
# command declared skips this gate rather than guessing how to run its suite.
TEST_CMD="$(python3 - "$repo" <<'PY'
import json, os, sys
try:
    with open(os.path.join(sys.argv[1], '.harness.json')) as f:
        print(json.load(f).get('test_command', ''))
except Exception:
    print('')
PY
)"

if [ -n "$TEST_CMD" ]; then
    echo "[pre-push] running tests: $TEST_CMD"
    if ! (cd "$repo" && eval "$TEST_CMD"); then
        echo ""
        echo "[pre-push] tests failed — push aborted."
        echo "[pre-push]    Fix them, or override with: git push --no-verify"
        exit 1
    fi
    echo "[pre-push] tests passed — pushing."
else
    echo "[pre-push] no test_command in .harness.json — test gate skipped."
fi
